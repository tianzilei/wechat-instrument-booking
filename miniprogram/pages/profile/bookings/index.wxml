<view class="page">
  <view class="segmented">
    <view wx:for="{{filters}}" wx:key="value" class="segmented-item {{activeFilter === item.value ? 'segmented-item--active' : ''}}" data-value="{{item.value}}" bindtap="changeFilter">{{item.label}}</view>
  </view>

  <view class="section">
    <empty-state wx:if="{{bookings.length === 0}}" title="暂无预约记录" description="从周历选择时间后，这里会显示你的预约。" />
    <view wx:if="{{bookings.length > 0}}" class="surface-section">
      <view wx:for="{{bookings}}" wx:key="_id" class="list-card booking-card" data-id="{{item._id}}" bindtap="openDetail">
        <view class="row-between">
          <view class="booking-time">{{item.timeText}}</view>
          <status-tag text="{{item.statusText}}" tone="{{item.statusTone}}" />
        </view>
        <view class="page-subtitle">{{item.detailLabel}}：{{item.detailText}}</view>
      </view>
    </view>
  </view>
</view>
