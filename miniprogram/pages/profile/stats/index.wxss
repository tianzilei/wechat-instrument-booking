.trend-table {
  padding-right: var(--page-gutter);
  padding-left: var(--page-gutter);
}

.trend-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  min-height: 72rpx;
}

.trend-row:last-child {
  margin-bottom: 0;
}

.trend-month,
.trend-hours {
  color: var(--color-text-secondary);
  font-size: var(--font-size-sm);
}

.trend-hours {
  color: var(--color-text);
  font-weight: 600;
}
