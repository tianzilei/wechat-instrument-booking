.profile-summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  padding-top: 24rpx;
  padding-bottom: 24rpx;
}

.profile-name {
  font-size: var(--font-size-lg);
  font-weight: 700;
}

.profile-section-title {
  margin-top: 24rpx;
}

.nav-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 96rpx;
}

.nav-title {
  font-size: var(--font-size-md);
  font-weight: 600;
}

.logout-text {
  color: var(--color-danger);
}
