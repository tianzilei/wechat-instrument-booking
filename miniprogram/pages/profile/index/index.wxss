.profile-dashboard {
  --dashboard-accent: var(--color-accent);
}

.profile-summary {
  align-items: flex-start;
}

.profile-name {
  font-size: var(--font-size-lg);
  font-weight: 700;
}

.profile-section-title {
  margin-top: 24rpx;
}

.profile-entry-panel {
  --dashboard-accent: var(--color-accent);
}

.nav-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 96rpx;
}

.nav-title {
  font-size: var(--font-size-md);
  font-weight: 600;
}

.logout-text {
  color: var(--color-danger);
}
