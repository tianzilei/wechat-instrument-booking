.waitlist-card {
  margin-bottom: 0;
}

.waitlist-time {
  font-weight: 600;
}

.waitlist-segments {
  margin-top: 8rpx;
}

.waitlist-deadline {
  color: var(--color-warning);
}

.waitlist-actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
  margin-top: 16rpx;
}
