<view class="page">
  <empty-state wx:if="{{items.length === 0}}" title="暂无用户" />
  <view wx:if="{{items.length > 0}}" class="surface-section">
    <view wx:for="{{items}}" wx:key="_id" class="list-card user-card">
      <view class="row-between">
        <view class="user-name">{{item.name || '未填写姓名'}}</view>
        <status-tag text="{{item.statusText}}" tone="{{item.statusTone}}" />
      </view>
      <view class="page-subtitle">{{item.projectName ? item.projectName + ' · ' + item.projectAbbr : '未关联课题'}}</view>
      <view class="page-subtitle">注册状态：{{item.registrationStatus === 'approved' ? '已通过' : (item.registrationStatus || '未知')}}</view>
      <view class="review-actions">
        <button wx:if="{{item.role !== 'admin' && item.accountStatus !== 'suspended' && item.accountStatus !== 'deleting'}}" class="button button--danger button--compact" data-id="{{item._id}}" data-name="{{item.name}}" bindtap="suspendUser">暂停账号</button>
        <button wx:if="{{item.role !== 'admin' && item.accountStatus === 'suspended'}}" class="button button--secondary button--compact" data-id="{{item._id}}" data-name="{{item.name}}" bindtap="restoreUser">恢复账号</button>
      </view>
    </view>
  </view>

  <theme-modal
    visible="{{modal.visible}}"
    title="{{modal.title}}"
    content="{{modal.content}}"
    show-input="{{modal.showInput}}"
    placeholder="{{modal.placeholder}}"
    confirm-text="{{modal.confirmText}}"
    confirm-tone="{{modal.confirmTone}}"
    payload="{{modal.payload}}"
    bind:cancel="closeModal"
    bind:confirm="confirmModal"
  />
</view>
