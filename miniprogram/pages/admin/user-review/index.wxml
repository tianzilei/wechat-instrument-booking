<view class="page">
  <view class="page-intro">统一处理注册审核和课题申请。</view>

  <view class="section">
    <view class="section-title">注册待审</view>
    <empty-state wx:if="{{userItems.length === 0}}" title="暂无注册待审" />
    <view wx:if="{{userItems.length > 0}}" class="surface-section">
      <view wx:for="{{userItems}}" wx:key="_id" class="list-card review-card" data-id="{{item._id}}" bindtap="openRegistrationDetail">
        <view class="row-between">
          <view class="review-title">{{item.nameSnapshot}}</view>
          <status-tag text="待审核" tone="warning" />
        </view>
        <view class="page-subtitle">{{item.projectName}} · {{item.projectAbbr}}</view>
        <view class="page-subtitle">提交时间：{{item.createdAt ? item.createdAt.slice(0,10) : ''}}</view>
      </view>
    </view>
  </view>

  <view class="section">
    <view class="section-title">课题申请待审</view>
    <empty-state wx:if="{{projectItems.length === 0}}" title="暂无课题待审" />
    <view wx:if="{{projectItems.length > 0}}" class="surface-section">
      <view wx:for="{{projectItems}}" wx:key="_id" class="list-card review-card" data-id="{{item._id}}" bindtap="openProjectDetail">
        <view class="row-between">
          <view class="review-title">{{item.proposedName || '未填写课题名称'}}</view>
          <status-tag text="待审核" tone="warning" />
        </view>
        <view class="page-subtitle">申请人：{{item.userName || '未知用户'}} · 缩写：{{item.proposedAbbr || '未填写'}}</view>
        <view class="page-subtitle">提交时间：{{item.createdAt ? item.createdAt.slice(0,10) : ''}}</view>
      </view>
    </view>
  </view>
</view>
