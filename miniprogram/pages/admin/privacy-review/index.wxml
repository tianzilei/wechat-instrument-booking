<view class="page">
  <view class="page-intro">处理用户提交的隐私请求（查询、更正、删除、撤回同意、注销、投诉）。</view>

  <view wx:if="{{items.length > 0}}" class="surface-section">
    <view class="list-card" wx:for="{{items}}" wx:key="_id">
      <view>
        <view class="nav-title">{{getTypeLabel(item.type)}}</view>
        <view wx:if="{{item.note}}" class="page-subtitle">说明：{{item.note}}</view>
        <view class="page-subtitle">提交时间：{{item.createdAt ? item.createdAt.slice(0,10) : ''}}</view>
      </view>
      <view class="review-actions">
        <button class="button button--secondary button--compact" data-id="{{item._id}}" bindtap="processing">处理中</button>
        <button class="button button--secondary button--compact" data-id="{{item._id}}" bindtap="complete">完成</button>
        <button class="button button--danger button--compact" data-id="{{item._id}}" bindtap="reject">拒绝</button>
      </view>
    </view>
  </view>

  <empty-state wx:else title="暂无隐私请求" description="当用户提交隐私请求时在此显示" />

  <theme-modal
    visible="{{modal.visible}}"
    title="{{modal.title}}"
    show-input="{{true}}"
    placeholder="请输入处理说明"
    confirm-text="确认"
    confirm-tone="primary"
    payload="{{modal}}"
    bind:close="closeModal"
    bind:confirm="confirmModal"
  />
</view>