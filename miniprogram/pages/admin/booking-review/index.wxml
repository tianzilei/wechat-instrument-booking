<view class="page">
  <empty-state wx:if="{{items.length === 0}}" title="暂无预约待审" />
  <view wx:if="{{items.length > 0}}" class="surface-section">
    <view wx:for="{{items}}" wx:key="_id" class="list-card review-card" data-id="{{item._id}}" bindtap="openDetail">
      <view class="row-between">
        <view class="review-title">{{item.userName}} · {{item.projectAbbr || '未关联课题'}}</view>
        <status-tag text="待审核" tone="warning" />
      </view>
      <view class="page-subtitle">{{item.timeText}}</view>
      <view class="page-subtitle">需审核规则：{{item.ruleText}}</view>
      <view class="page-subtitle">用户备注：{{item.remark || '无备注'}}</view>
      <view class="page-subtitle">点击查看详情并处理</view>
    </view>
  </view>
</view>
