<view class="page">
  <empty-state wx:if="{{items.length === 0}}" title="暂无预约待审" />
  <view wx:for="{{items}}" wx:key="_id" class="list-card review-card">
    <view class="row-between">
      <view class="review-title">{{item.userName}} · {{item.college}}</view>
      <status-tag text="待审核" tone="warning" />
    </view>
    <view class="page-subtitle">{{item.timeText}}</view>
    <view class="page-subtitle">原因：{{item.reasonText}}</view>
    <view class="page-subtitle">备注：{{item.remark || '无'}}</view>
    <view class="review-actions">
      <button class="button button--primary" data-id="{{item._id}}" data-action="approve" bindtap="review">通过</button>
      <button class="button button--danger" data-id="{{item._id}}" data-action="reject" bindtap="review">拒绝</button>
    </view>
  </view>
</view>
