<view class="page">
  <empty-state wx:if="{{!detail}}" title="暂无申请信息" />

  <block wx:else>
    <view class="section">
      <view class="section-title">申请信息</view>
      <view class="surface-section">
        <view class="list-card detail-card">
          <view class="row-between">
            <view class="detail-title">{{detail.nameSnapshot || '未填写姓名'}}</view>
            <status-tag text="{{detail.statusText}}" tone="{{detail.statusTone}}" />
          </view>
          <view class="detail-line">
            <view class="detail-label">申请时间</view>
            <view class="detail-value">{{detail.createdAtText}}</view>
          </view>
          <view class="detail-line">
            <view class="detail-label">关联课题</view>
            <view class="detail-value">{{detail.projectName || '未关联课题'}}{{detail.projectAbbr ? ' · ' + detail.projectAbbr : ''}}</view>
          </view>
          <view class="detail-line">
            <view class="detail-label">服务协议版本</view>
            <view class="detail-value">{{detail.agreementVersion || '未记录'}}</view>
          </view>
          <view class="detail-line">
            <view class="detail-label">隐私政策版本</view>
            <view class="detail-value">{{detail.privacyVersion || '未记录'}}</view>
          </view>
          <view wx:if="{{detail.reviewReason}}" class="detail-line">
            <view class="detail-label">拒绝原因</view>
            <view class="detail-value">{{detail.reviewReason}}</view>
          </view>
        </view>
      </view>
    </view>

    <view wx:if="{{detail.canReview}}" class="section">
      <view class="section-title">处理操作</view>
      <view class="surface-section detail-actions">
        <button class="button button--danger" bindtap="reject">拒绝</button>
        <button class="button button--primary" bindtap="approve">通过</button>
      </view>
    </view>
  </block>

  <theme-modal
    visible="{{modal.visible}}"
    title="{{modal.title}}"
    content="{{modal.content}}"
    show-input="{{modal.showInput}}"
    placeholder="{{modal.placeholder}}"
    confirm-text="{{modal.confirmText}}"
    confirm-tone="{{modal.confirmTone}}"
    payload="{{modal.payload}}"
    bind:cancel="closeModal"
    bind:confirm="confirmModal"
  />
</view>
