<view class="page">
  <view class="surface-section admin-form-section">
    <view class="section-title">新增受限时段</view>
    <view class="field">
      <view class="field-label">开始时间</view>
      <input class="input" value="{{form.startAt}}" data-field="startAt" bindinput="onInput" placeholder="例：2026-06-10 18:00" />
    </view>
    <view class="field">
      <view class="field-label">结束时间</view>
      <input class="input" value="{{form.endAt}}" data-field="endAt" bindinput="onInput" placeholder="例：2026-06-10 20:00" />
    </view>
    <view class="field">
      <view class="field-label">原因</view>
      <textarea class="textarea" value="{{form.reason}}" data-field="reason" bindinput="onInput" placeholder="受限原因"></textarea>
    </view>
    <button class="button button--primary" bindtap="create">新增受限时段</button>
  </view>

  <view class="section">
    <view class="section-title">受限列表</view>
    <empty-state wx:if="{{items.length === 0}}" title="暂无受限时段" />
    <view wx:if="{{items.length > 0}}" class="surface-section">
      <view wx:for="{{items}}" wx:key="_id" class="list-card slot-card">
        <view class="slot-time">{{item.timeText}}</view>
        <view class="page-subtitle">{{item.reason || '无原因'}}</view>
      </view>
    </view>
  </view>
</view>
