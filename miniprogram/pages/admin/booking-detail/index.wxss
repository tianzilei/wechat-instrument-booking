.detail-card {
  margin-bottom: 0;
}

.detail-title,
.detail-segment,
.detail-log {
  font-weight: 600;
}

.detail-line {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin-top: 12rpx;
}

.detail-label {
  flex: 0 0 144rpx;
  color: var(--color-text-secondary);
  font-size: var(--font-size-sm);
}

.detail-value {
  flex: 1;
  min-width: 0;
  color: var(--color-text);
  font-size: var(--font-size-sm);
  line-height: 1.6;
}

.detail-actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}
