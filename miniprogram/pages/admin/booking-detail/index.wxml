<view class="page">
  <empty-state wx:if="{{!booking}}" title="暂无预约信息" />

  <block wx:else>
    <view class="surface-section">
      <view class="list-card detail-card">
        <view class="row-between">
          <view class="detail-title">{{booking.userName || '未知用户'}} · {{booking.projectAbbr || '未关联课题'}}</view>
          <status-tag text="{{booking.statusText}}" tone="{{booking.statusTone}}" />
        </view>
        <view class="page-subtitle">{{booking.timeText}}</view>
        <view class="page-subtitle">预约类型：{{booking.bookingType === 'special' ? '特殊预约' : '常规预约'}}</view>
        <view class="page-subtitle">触发规则：{{booking.ruleText}}</view>
        <view class="page-subtitle">用户备注：{{booking.remark || '无备注'}}</view>
        <view wx:if="{{booking.reviewReason}}" class="page-subtitle">审核说明：{{booking.reviewReason}}</view>
        <view wx:if="{{booking.cancellationNote}}" class="page-subtitle">取消说明：{{booking.cancellationNote}}</view>
      </view>
    </view>

    <view class="section">
      <view class="section-title">时段明细</view>
      <view class="surface-section">
        <view wx:for="{{booking.segments}}" wx:key="timeText" class="list-card detail-card">
          <view class="row-between">
            <view class="detail-segment">{{item.timeText}}</view>
            <status-tag text="{{item.cancelled ? '已取消' : '有效'}}" tone="{{item.cancelled ? 'muted' : 'success'}}" />
          </view>
        </view>
      </view>
    </view>

    <view class="section">
      <view class="section-title">处理记录</view>
      <empty-state wx:if="{{booking.reviewLogs.length === 0}}" title="暂无处理记录" />
      <view wx:if="{{booking.reviewLogs.length > 0}}" class="surface-section">
        <view wx:for="{{booking.reviewLogs}}" wx:key="createdAt" class="list-card detail-card">
          <view class="detail-log">{{item.action}}</view>
          <view class="page-subtitle">{{item.reason || '无说明'}}</view>
        </view>
      </view>
    </view>

    <view wx:if="{{booking.status === 'pending_review'}}" class="section">
      <view class="surface-section detail-actions">
        <button class="button button--primary" data-action="approve" bindtap="review">通过</button>
        <button class="button button--danger" data-action="reject" bindtap="review">拒绝</button>
      </view>
    </view>
  </block>

  <theme-modal
    visible="{{modal.visible}}"
    title="{{modal.title}}"
    content="{{modal.content}}"
    show-input="{{modal.showInput}}"
    placeholder="{{modal.placeholder}}"
    confirm-text="{{modal.confirmText}}"
    confirm-tone="{{modal.confirmTone}}"
    payload="{{modal.payload}}"
    bind:cancel="closeModal"
    bind:confirm="confirmModal"
  />
</view>
