<view class="page">
  <empty-state wx:if="{{!booking}}" title="暂无预约信息" />

  <block wx:else>
    <view class="section">
      <view class="section-title">预约信息</view>
      <view class="surface-section">
        <view class="list-card detail-card">
          <view class="row-between">
            <view class="detail-title">{{booking.userName || '未知用户'}} · {{booking.projectAbbr || '未关联课题'}}</view>
            <status-tag text="{{booking.statusText}}" tone="{{booking.statusTone}}" />
          </view>
          <view class="detail-line">
            <view class="detail-label">预约时段</view>
            <view class="detail-value">{{booking.timeText}}</view>
          </view>
          <view class="detail-line">
            <view class="detail-label">预约类型</view>
            <view class="detail-value">{{booking.bookingType === 'special' ? '特殊预约' : '常规预约'}}</view>
          </view>
          <view class="detail-line">
            <view class="detail-label">触发规则</view>
            <view class="detail-value">{{booking.ruleText}}</view>
          </view>
          <view class="detail-line">
            <view class="detail-label">用户备注</view>
            <view class="detail-value">{{booking.remark || '无备注'}}</view>
          </view>
          <view wx:if="{{booking.reviewReason}}" class="detail-line">
            <view class="detail-label">审核说明</view>
            <view class="detail-value">{{booking.reviewReason}}</view>
          </view>
          <view wx:if="{{booking.cancellationNote}}" class="detail-line">
            <view class="detail-label">取消说明</view>
            <view class="detail-value">{{booking.cancellationNote}}</view>
          </view>
        </view>
      </view>
    </view>

    <view class="section">
      <view class="section-title">时段明细</view>
      <view class="surface-section">
        <view wx:for="{{booking.segments}}" wx:key="timeText" class="list-card detail-card">
          <view class="row-between">
            <view class="detail-segment">{{item.timeText}}</view>
            <status-tag text="{{item.cancelled ? '已取消' : '有效'}}" tone="{{item.cancelled ? 'muted' : 'success'}}" />
          </view>
        </view>
      </view>
    </view>

    <view class="section">
      <view class="section-title">处理记录</view>
      <empty-state wx:if="{{booking.reviewLogs.length === 0}}" title="暂无处理记录" />
      <view wx:if="{{booking.reviewLogs.length > 0}}" class="surface-section">
        <view wx:for="{{booking.reviewLogs}}" wx:key="createdAt" class="list-card detail-card">
          <view class="row-between">
            <view class="detail-log">{{item.actionText}}</view>
            <view class="page-subtitle">{{item.timeText}}</view>
          </view>
          <view wx:if="{{item.reasonText}}" class="page-subtitle">{{item.reasonText}}</view>
        </view>
      </view>
    </view>

    <view wx:if="{{booking.canReview}}" class="section">
      <view class="section-title">处理操作</view>
      <view class="surface-section detail-actions">
        <button class="button button--danger" data-action="reject" bindtap="review">{{booking.rejectText}}</button>
        <button class="button button--primary" data-action="approve" bindtap="review">{{booking.approveText}}</button>
      </view>
    </view>
  </block>

  <theme-modal
    visible="{{modal.visible}}"
    title="{{modal.title}}"
    content="{{modal.content}}"
    show-input="{{modal.showInput}}"
    placeholder="{{modal.placeholder}}"
    confirm-text="{{modal.confirmText}}"
    confirm-tone="{{modal.confirmTone}}"
    payload="{{modal.payload}}"
    bind:cancel="closeModal"
    bind:confirm="confirmModal"
  />
</view>
