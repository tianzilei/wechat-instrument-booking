<view class="page">
  <view class="page-intro">处理用户提交的新课题申请。通过后课题进入正式目录，由申请人确认。</view>

  <view wx:if="{{items.length > 0}}" class="surface-section">
    <view class="list-card" wx:for="{{items}}" wx:key="_id">
      <view>
        <view class="nav-title">{{item.proposedName}}</view>
        <view class="page-subtitle">缩写：{{item.proposedAbbr}}</view>
        <view class="page-subtitle">提交时间：{{item.createdAt ? item.createdAt.slice(0,10) : ''}}</view>
      </view>
      <view class="review-actions">
        <button class="button button--secondary button--compact" data-application="{{item}}" bindtap="approve">通过</button>
        <button class="button button--danger button--compact" data-application="{{item}}" bindtap="reject">拒绝</button>
      </view>
    </view>
  </view>

  <empty-state wx:else title="暂无待审核课题" description="当用户提交新课题申请时在此显示" />

  <theme-modal
    visible="{{modal.visible}}"
    title="{{modal.title}}"
    show-input="{{modal.showInput}}"
    placeholder="{{modal.placeholder}}"
    confirm-text="{{modal.confirmText}}"
    confirm-tone="{{modal.confirmTone}}"
    payload="{{modal.payload}}"
    bind:close="closeModal"
    bind:confirm="confirmModal"
  />
</view>