.admin-dashboard {
  --dashboard-accent: var(--color-maintenance);
}

.admin-summary {
  align-items: flex-start;
}

.admin-summary__title {
  font-size: var(--font-size-lg);
  font-weight: 700;
}

.admin-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 96rpx;
}

.admin-nav__title {
  font-weight: 600;
}

.admin-nav-panel {
  --dashboard-accent: var(--color-maintenance);
}
