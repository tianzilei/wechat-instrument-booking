.admin-tab-bar-scrim {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 999;
  height: calc(var(--tab-bar-height) + env(safe-area-inset-bottom));
  pointer-events: none;
  background-color: var(--color-surface);
}

.admin-summary__row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 88rpx;
  border-bottom: 1rpx solid var(--color-divider);
}

.admin-summary__row:last-child {
  border-bottom: 0;
}

.admin-summary__value {
  color: var(--color-primary);
  font-size: var(--font-size-lg);
  font-weight: 700;
}

.admin-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 96rpx;
}

.admin-nav__title {
  font-weight: 600;
}
