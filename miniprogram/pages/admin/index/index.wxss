.admin-todo-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}

.admin-todo-card {
  min-height: 224rpx;
  padding: 24rpx;
}

.admin-todo-card__count {
  color: var(--color-primary);
  font-size: 56rpx;
  font-weight: 700;
  line-height: 1;
}

.admin-todo-card__title {
  margin-top: 16rpx;
  font-weight: 700;
}

.admin-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 96rpx;
}

.admin-nav__title {
  font-weight: 600;
}

@media (max-width: 620rpx) {
  .admin-todo-grid {
    grid-template-columns: 1fr;
  }
}
