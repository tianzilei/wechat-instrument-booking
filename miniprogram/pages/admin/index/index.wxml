<view class="page">
  <view class="tab-bar-scrim"></view>
  <view class="page-intro">优先从待办直达处理，再进入维护和系统设置等非待办功能。</view>

  <empty-state wx:if="{{!isAdmin}}" title="暂无管理权限" description="管理员身份需要在数据库中手动设置。" />

  <block wx:else>
    <view class="section">
      <view class="section-title">待办直达</view>
      <view class="admin-todo-grid">
        <view wx:for="{{todoCards}}" wx:key="key" class="surface-section admin-todo-card" data-url="{{item.url}}" bindtap="goPage">
          <view class="admin-todo-card__count">{{item.count}}</view>
          <view class="admin-todo-card__title">{{item.title}}</view>
          <view class="page-subtitle">{{item.desc}}</view>
        </view>
      </view>
    </view>

    <view class="section">
      <view class="section-title">其他功能</view>
      <view class="surface-section">
        <view wx:for="{{navs}}" wx:key="url" class="list-card admin-nav" data-url="{{item.url}}" bindtap="goPage">
          <view>
            <view class="admin-nav__title">{{item.title}}</view>
            <view class="page-subtitle">{{item.desc}}</view>
          </view>
        </view>
      </view>
    </view>
  </block>
</view>
