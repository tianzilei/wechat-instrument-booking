<view class="page">
  <view class="admin-tab-bar-scrim"></view>
  <view class="page-intro">优先处理临近开始的审核事项，再进入对应管理功能。</view>

  <empty-state wx:if="{{!isAdmin}}" title="暂无管理权限" description="管理员身份需要在数据库中手动设置。" />

  <block wx:else>
    <view class="section-title">待办</view>
    <view class="surface-section admin-summary">
      <view class="admin-summary__row">
        <view>预约待审</view>
        <view class="admin-summary__value">{{dashboard.bookingPending || 0}}</view>
      </view>
      <view class="admin-summary__row">
        <view>取消待审</view>
        <view class="admin-summary__value">{{dashboard.cancelPending || 0}}</view>
      </view>
      <view class="admin-summary__row">
        <view>注册待审</view>
        <view class="admin-summary__value">{{dashboard.registrationPending || 0}}</view>
      </view>
      <view class="admin-summary__row">
        <view>本月已完成小时</view>
        <view class="admin-summary__value">{{dashboard.monthHours || 0}}</view>
      </view>
    </view>

    <view class="section">
      <view class="section-title">管理功能</view>
      <view class="surface-section">
        <view wx:for="{{navs}}" wx:key="url" class="list-card admin-nav" data-url="{{item.url}}" bindtap="goPage">
          <view>
            <view class="admin-nav__title">{{item.title}}</view>
            <view class="page-subtitle">{{item.desc}}</view>
          </view>
        </view>
      </view>
    </view>
  </block>
</view>
