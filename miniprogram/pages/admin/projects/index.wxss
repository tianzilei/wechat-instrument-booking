.privacy-actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
  width: 100%;
  margin-top: 16rpx;
}
.privacy-actions .button { width: 100%; }
.project-info { flex: 1; min-width: 0; padding-right: 16rpx; }
.project-info .nav-title { overflow-wrap: anywhere; }
.project-actions { display: flex; flex: none; gap: 8rpx; }
.project-actions .button { width: 112rpx; }
