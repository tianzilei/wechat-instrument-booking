.privacy-actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
  width: 100%;
  margin-top: 16rpx;
}
.privacy-actions .button { width: 100%; }
.settings-row { width: 100%; }
.settings-copy { flex: 1; min-width: 0; }
.settings-action { flex: none; width: 184rpx; margin-left: auto; }
.export-section { padding-top: 24rpx; padding-bottom: 24rpx; }
