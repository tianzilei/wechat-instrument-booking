<view class="calendar-shell">
  <view class="tab-bar-scrim"></view>
  <view class="calendar-toolbar">
    <view class="calendar-week-title">{{weekTitle}}</view>
    <view class="calendar-user-hint">{{userHint}}</view>
    <view class="calendar-window-hint">{{bookingWindowHint}}</view>
    <view class="calendar-control-row">
      <view class="calendar-actions">
        <button class="calendar-action {{isSelecting ? 'calendar-action--disabled' : ''}}" bindtap="prevWeek">上周</button>
        <button class="calendar-action {{isSelecting ? 'calendar-action--disabled' : ''}}" bindtap="nextWeek">下周</button>
      </view>
      <view class="segmented calendar-mode">
        <view class="segmented-item {{!includeNight ? 'segmented-item--active' : ''}}" bindtap="showWorktime">工作时间</view>
        <view class="segmented-item {{includeNight ? 'segmented-item--active' : ''}}" bindtap="showFullDay">全天</view>
      </view>
    </view>
  </view>

  <scroll-view class="calendar-legend" scroll-x enhanced show-scrollbar="{{false}}">
    <view class="calendar-legend__inner">
      <view class="legend-item"><view class="legend-dot legend-dot--available"></view>可预约</view>
      <view class="legend-item"><view class="legend-dot legend-dot--booked"></view>已预约</view>
      <view class="legend-item"><view class="legend-dot legend-dot--pending"></view>待审核</view>
      <view class="legend-item"><view class="legend-dot legend-dot--maintenance"></view>维护</view>
    </view>
  </scroll-view>

  <calendar-grid
    days="{{days}}"
    hours="{{hours}}"
    items="{{items}}"
    maintenance-slots="{{maintenanceSlots}}"
    is-admin="{{isAdminView}}"
    bind:celltap="onGridCellTap"
    bind:selectrange="onSelectRange"
    bind:selectmodechange="onSelectModeChange"
  />

  <time-range-sheet
    visible="{{sheet.visible}}"
    title="{{sheet.title}}"
    time-text="{{sheet.timeText}}"
    hint="{{sheet.hint}}"
    hint-tone="{{sheet.hintTone}}"
    submit-text="{{sheet.submitText}}"
    cancel-text="{{sheet.cancelText}}"
    disabled="{{sheet.disabled}}"
    primary-class="{{sheet.primaryClass}}"
    show-submit="{{sheet.showSubmit}}"
    show-remark="{{sheet.showRemark}}"
    detail-lines="{{sheet.detailLines}}"
    bind:close="closeSheet"
    bind:submit="submitSheet"
  />

  <theme-modal
    visible="{{maintenanceModal.visible}}"
    title="{{maintenanceModal.title}}"
    content="{{maintenanceModal.content}}"
    confirm-text="{{maintenanceModal.confirmText}}"
    confirm-tone="{{maintenanceModal.confirmTone}}"
    payload="{{maintenanceModal.payload}}"
    bind:cancel="closeMaintenanceModal"
    bind:confirm="confirmMaintenanceModal"
  />
</view>
