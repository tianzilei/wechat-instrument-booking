<view class="page">
  <view class="page-header">
    <view>
      <view class="page-title">注册申请</view>
      <view class="page-subtitle">管理员审核通过后即可预约仪器。</view>
    </view>
  </view>

  <view class="field">
    <view class="field-label">姓名</view>
    <input class="input" value="{{form.name}}" data-field="name" bindinput="onInput" placeholder="请输入姓名" />
  </view>
  <view class="field">
    <view class="field-label">手机号</view>
    <input class="input" type="number" value="{{form.phone}}" data-field="phone" bindinput="onInput" placeholder="请输入手机号" />
  </view>
  <view class="field">
    <view class="field-label">学号</view>
    <input class="input" value="{{form.studentId}}" data-field="studentId" bindinput="onInput" placeholder="请输入学号" />
  </view>
  <view class="field">
    <view class="field-label">学院</view>
    <input class="input" value="{{form.college}}" data-field="college" bindinput="onInput" placeholder="请输入学院" />
  </view>
  <view class="field">
    <view class="field-label">导师/负责人</view>
    <input class="input" value="{{form.supervisor}}" data-field="supervisor" bindinput="onInput" placeholder="请输入导师或负责人" />
  </view>

  <button class="button button--primary" loading="{{loading}}" bindtap="submit">提交审核</button>
</view>
