.login-summary {
  padding-top: 24rpx;
  padding-bottom: 24rpx;
}

.login-name {
  font-size: var(--font-size-lg);
  font-weight: 700;
}

.action-gap {
  margin-top: 16rpx;
}

.legal-consent {
  margin-top: 24rpx;
  padding-top: 24rpx;
  padding-bottom: 24rpx;
}

.legal-consent-text {
  color: var(--color-text-secondary);
  font-size: var(--font-size-sm);
  line-height: 1.55;
}

.legal-links {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx 20rpx;
  margin-top: 16rpx;
}

.legal-link {
  color: var(--color-primary);
  font-size: var(--font-size-sm);
}

.legal-accept {
  margin-top: 24rpx;
}
