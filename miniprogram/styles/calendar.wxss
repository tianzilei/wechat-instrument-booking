.calendar-shell {
  min-height: 100vh;
  padding-bottom: calc(136rpx + env(safe-area-inset-bottom));
}

.calendar-toolbar {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: 8rpx;
  padding: 12rpx 24rpx 10rpx;
  background: var(--color-bg);
}

.calendar-week-title {
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: var(--font-size-lg);
  font-weight: 800;
  line-height: 1.2;
}

.calendar-user-hint {
  color: var(--color-text-secondary);
  font-size: var(--font-size-sm);
  line-height: 1.3;
}

.calendar-actions {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 8rpx;
}

.calendar-action {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-height: 60rpx;
  padding: 0;
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-md);
  background: var(--color-surface);
  color: var(--color-text);
  font-size: var(--font-size-md);
  font-weight: 600;
  line-height: 1;
}

.calendar-legend {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  padding: 0 24rpx 12rpx;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  color: var(--color-text-secondary);
  font-size: var(--font-size-xs);
}

.legend-dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  border: 1rpx solid var(--color-border);
}

.legend-dot--available {
  background: var(--color-surface);
}

.legend-dot--booked {
  background: var(--color-primary-soft);
  border-color: var(--color-primary);
}

.legend-dot--pending {
  background: var(--color-warning-soft);
  border-color: var(--color-warning);
}

.legend-dot--maintenance {
  background: var(--color-maintenance-soft);
  border-color: var(--color-maintenance);
}

.legend-dot--restricted {
  background: var(--color-restricted-soft);
  border-color: var(--color-restricted);
}
