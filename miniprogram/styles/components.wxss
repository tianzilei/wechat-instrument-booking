.card {
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-md);
  background: var(--color-surface);
}

.list-card {
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--color-divider);
  background: var(--color-surface);
}

.list-card:first-child {
  border-top: 1rpx solid var(--color-divider);
}

.surface-section {
  margin-right: -24rpx;
  margin-left: -24rpx;
  padding: 0 var(--page-gutter);
  border-top: 1rpx solid var(--color-divider);
  border-bottom: 1rpx solid var(--color-divider);
  background: var(--color-surface);
}

.row {
  display: flex;
  align-items: center;
}

.row-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  max-width: 100%;
  min-width: 0;
  min-height: var(--control-height);
  padding: 0 24rpx;
  border-radius: var(--radius-md);
  font-weight: 600;
  line-height: 1.25;
  text-align: center;
  white-space: normal;
}

.button--primary {
  background: var(--color-primary);
  color: var(--color-text-inverse);
}

.button--secondary {
  border: 1rpx solid var(--color-primary);
  background: var(--color-surface);
  color: var(--color-primary);
}

.button--danger {
  border: 1rpx solid var(--color-danger);
  background: var(--color-surface);
  color: var(--color-danger);
}

.button--ghost {
  background: transparent;
  color: var(--color-primary);
}

.button--disabled {
  background: var(--color-surface-muted);
  color: var(--color-text-muted);
}

.button--compact {
  min-height: var(--control-height-compact);
  padding-right: 24rpx;
  padding-left: 24rpx;
  font-size: var(--font-size-sm);
}

.field {
  margin-bottom: 24rpx;
}

.field-label {
  margin-bottom: 8rpx;
  color: var(--color-text);
  font-size: var(--font-size-sm);
  font-weight: 600;
}

.input {
  min-height: var(--control-height);
  padding: 0 24rpx;
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-md);
  background: var(--color-surface);
}

.textarea {
  min-height: 160rpx;
  padding: 24rpx;
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-md);
  background: var(--color-surface);
}

.error-text {
  margin-top: 8rpx;
  color: var(--color-danger);
  font-size: var(--font-size-xs);
}

.segmented {
  display: flex;
  padding: 4rpx;
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-md);
  background: var(--color-surface-muted);
}

.segmented-item {
  flex: 1;
  min-height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-sm);
  color: var(--color-text-secondary);
  font-size: var(--font-size-md);
}

.segmented-item--active {
  background: var(--color-primary-soft);
  color: var(--color-primary);
  font-weight: 600;
}

.stat-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}

.dashboard-summary {
  --dashboard-accent: var(--color-primary);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  padding-top: 24rpx;
  padding-bottom: 24rpx;
}

.dashboard-grid {
  --dashboard-accent: var(--color-primary);
}

.dashboard-stat {
  position: relative;
  overflow: hidden;
  min-height: 152rpx;
  padding-top: 30rpx;
}

.dashboard-stat::before {
  content: '';
  position: absolute;
  top: 0;
  right: 0;
  left: 0;
  height: 6rpx;
  background: var(--dashboard-accent);
}

.dashboard-stat__value {
  color: var(--dashboard-accent);
  font-size: var(--font-size-xl);
  font-weight: 700;
  line-height: var(--line-tight);
}

.dashboard-stat__title {
  margin-top: 12rpx;
  font-weight: 700;
}

.dashboard-stat__desc {
  margin-top: 8rpx;
  color: var(--color-text-secondary);
  font-size: var(--font-size-sm);
  line-height: 1.55;
}

.dashboard-note {
  --dashboard-accent: var(--color-primary);
  padding: 16rpx;
  border-left: 4rpx solid var(--dashboard-accent);
  background: var(--color-surface-muted);
  color: var(--color-text-secondary);
  font-size: var(--font-size-sm);
  line-height: 1.55;
}

.stat-card {
  min-height: 144rpx;
  padding: 24rpx;
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-md);
  background: var(--color-surface);
}

.stat-value {
  font-size: var(--font-size-xl);
  font-weight: 700;
  line-height: var(--line-tight);
}

.stat-label {
  margin-top: 8rpx;
  color: var(--color-text-secondary);
  font-size: var(--font-size-sm);
}

.status-tag {
  display: inline-flex;
  align-items: center;
  min-height: 40rpx;
  padding: 4rpx 12rpx;
  border: 1rpx solid currentColor;
  border-radius: var(--radius-sm);
  font-size: var(--font-size-xs);
  line-height: 1.2;
}

.status-tag--success {
  border-color: var(--color-success);
  background: var(--color-success-soft);
  color: var(--color-success);
}

.status-tag--warning {
  border-color: var(--color-warning);
  background: var(--color-warning-soft);
  color: var(--color-warning);
}

.status-tag--danger {
  border-color: var(--color-danger);
  background: var(--color-danger-soft);
  color: var(--color-danger);
}

.status-tag--accent {
  border-color: var(--color-accent);
  background: var(--color-accent-soft);
  color: var(--color-accent);
}

.status-tag--muted {
  border-color: var(--color-past);
  background: var(--color-past-soft);
  color: var(--color-past);
}

.tab-bar-scrim {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 999;
  height: calc(var(--tab-bar-height) + env(safe-area-inset-bottom));
  pointer-events: none;
  background-color: var(--color-surface);
}
