page {
  --color-bg: #f4f7f7;
  --color-surface: #ffffff;
  --color-surface-muted: #eef3f3;
  --color-border: #d5dedd;
  --color-border-strong: #aebdb9;
  --color-divider: #e6eceb;
  --color-text: #172321;
  --color-text-secondary: #566762;
  --color-text-muted: #74827e;
  --color-text-disabled: #66736f;
  --color-text-inverse: #ffffff;
  --color-primary: #0f766e;
  --color-primary-pressed: #0b5f59;
  --color-primary-soft: #dff2ef;
  --color-primary-selection: rgba(15, 118, 110, 0.16);
  --color-primary-selection-soft: rgba(15, 118, 110, 0.12);
  --color-accent: #1d5f8a;
  --color-accent-soft: #e1eff8;
  --color-success: #2f6f4e;
  --color-success-soft: #e4f1e9;
  --color-warning: #956515;
  --color-warning-soft: #fbf0d2;
  --color-danger: #a43b32;
  --color-danger-soft: #f9e5e2;
  --color-maintenance: #8e4038;
  --color-maintenance-soft: #f4e7e5;
  --color-restricted: #956515;
  --color-restricted-soft: #fbf0d2;
  --color-past: #66736f;
  --color-past-soft: #e9edec;
  --color-overlay: rgba(23, 35, 33, 0.42);
  --font-size-xs: 22rpx;
  --font-size-sm: 24rpx;
  --font-size-md: 28rpx;
  --font-size-lg: 30rpx;
  --font-size-xl: 36rpx;
  --line-tight: 1.25;
  --line-normal: 1.45;
  --space-1: 4rpx;
  --space-2: 8rpx;
  --space-3: 12rpx;
  --space-4: 16rpx;
  --space-5: 24rpx;
  --space-6: 32rpx;
  --space-7: 48rpx;
  --radius-sm: 6rpx;
  --radius-md: 8rpx;
  --radius-lg: 12rpx;
  --shadow-popover: 0 10rpx 30rpx rgba(23, 35, 33, 0.12);
  --page-gutter: 24rpx;
  --control-height: 80rpx;
  --control-height-compact: 64rpx;
  --tab-bar-height: 100rpx;
}
