@import "../../styles/components.wxss";

.empty-state {
  padding: 48rpx 24rpx;
  text-align: center;
}

.empty-state__title {
  color: var(--color-text);
  font-size: var(--font-size-md);
  font-weight: 600;
}

.empty-state__desc {
  margin-top: 8rpx;
  color: var(--color-text-secondary);
  font-size: var(--font-size-sm);
  line-height: 1.55;
}

.empty-state__button {
  margin: 24rpx auto 0;
  width: 280rpx;
  max-width: 100%;
}
