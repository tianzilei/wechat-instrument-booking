.calendar-scroll {
  width: 100%;
  height: calc(100vh - 260rpx);
  background: var(--color-bg);
}

.calendar-grid {
  display: grid;
  width: max-content;
  min-width: 100%;
  padding: 0 24rpx 24rpx;
}

.calendar-corner,
.calendar-day,
.calendar-hour,
.calendar-cell {
  border-right: 1rpx solid var(--color-border);
  border-bottom: 1rpx solid var(--color-border);
}

.calendar-corner {
  position: sticky;
  left: 0;
  z-index: 4;
  height: 92rpx;
  border-top: 1rpx solid var(--color-border);
  border-left: 1rpx solid var(--color-border);
  background: var(--color-bg);
}

.calendar-day {
  position: sticky;
  top: 0;
  z-index: 3;
  height: 92rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 0 12rpx;
  border-top: 1rpx solid var(--color-border);
  background: var(--color-surface);
}

.calendar-day--weekend {
  background: var(--color-surface-muted);
}

.calendar-day__label {
  color: var(--color-text);
  font-size: var(--font-size-sm);
  font-weight: 700;
}

.calendar-day__date {
  margin-top: 4rpx;
  color: var(--color-text-secondary);
  font-size: var(--font-size-xs);
}

.calendar-hour {
  position: sticky;
  left: 0;
  z-index: 2;
  height: 96rpx;
  display: flex;
  align-items: flex-start;
  justify-content: center;
  padding-top: 10rpx;
  border-left: 1rpx solid var(--color-border);
  background: var(--color-bg);
  color: var(--color-text-muted);
  font-size: var(--font-size-xs);
}

.calendar-cell {
  position: relative;
  height: 96rpx;
  padding: 10rpx 8rpx;
  background: var(--color-surface);
  color: var(--color-text-secondary);
  overflow: hidden;
  transition: background-color 120ms ease, border-color 120ms ease, transform 120ms ease;
}

.calendar-cell__text {
  font-size: var(--font-size-xs);
  font-weight: 700;
  line-height: 1.2;
}

.calendar-cell__sub {
  margin-top: 4rpx;
  font-size: 20rpx;
  line-height: 1.2;
}

.calendar-cell--available {
  background: var(--color-surface);
}

.calendar-cell--booked {
  border-left: 5rpx solid var(--color-primary);
  background: var(--color-primary-soft);
  color: var(--color-primary);
}

.calendar-cell--pending {
  border: 1rpx dashed var(--color-warning);
  background: var(--color-warning-soft);
  color: var(--color-warning);
}

.calendar-cell--maintenance {
  background: repeating-linear-gradient(
    135deg,
    var(--color-maintenance-soft),
    var(--color-maintenance-soft) 10rpx,
    #d5dce5 10rpx,
    #d5dce5 20rpx
  );
  color: var(--color-maintenance);
}

.calendar-cell--restricted {
  background: var(--color-restricted-soft);
  color: var(--color-restricted);
}

.calendar-cell--selected {
  border: 2rpx solid var(--color-accent);
  background: var(--color-accent-soft);
  color: var(--color-accent);
}

.calendar-cell--selecting {
  z-index: 1;
  border: 2rpx solid var(--color-accent);
  background: var(--color-accent-soft);
  color: var(--color-accent);
  box-shadow: inset 0 0 0 2rpx rgba(37, 99, 235, 0.18);
}

.calendar-cell--selecting::after {
  content: "";
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: var(--color-accent);
}

.calendar-cell__select-mark {
  position: absolute;
  right: 8rpx;
  bottom: 8rpx;
  padding: 3rpx 8rpx;
  border-radius: var(--radius-sm);
  background: rgba(37, 99, 235, 0.12);
  color: var(--color-accent);
  font-size: 18rpx;
  line-height: 1.2;
}
