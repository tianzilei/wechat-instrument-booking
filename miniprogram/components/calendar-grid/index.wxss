.calendar-scroll {
  width: 100%;
  height: calc(100vh - 260rpx);
  background: var(--color-surface);
}

.calendar-scroll--selecting {
  height: calc(100vh - 352rpx);
}

.multi-select-bar {
  position: sticky;
  top: 0;
  z-index: 20;
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: 12rpx;
  padding: 12rpx 24rpx;
  border-bottom: 1rpx solid var(--color-border);
  background: var(--color-surface);
  box-shadow: var(--shadow-popover);
}

.multi-select-bar__text {
  width: 100%;
  color: var(--color-primary);
  font-size: var(--font-size-sm);
  font-weight: 700;
  line-height: 1.25;
  text-align: center;
}

.multi-select-bar__actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  width: 100%;
}

.multi-select-bar__button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-width: 0;
  min-height: var(--control-height-compact);
  padding: 0;
  border-radius: var(--radius-md);
  font-size: var(--font-size-sm);
  font-weight: 700;
  line-height: 1;
  overflow: hidden;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.multi-select-bar__button--ghost {
  border: 1rpx solid var(--color-primary);
  background: var(--color-surface);
  color: var(--color-primary);
}

.multi-select-bar__button--primary {
  background: var(--color-primary);
  color: var(--color-text-inverse);
}

.calendar-grid {
  display: grid;
  width: max-content;
  min-width: 100%;
  padding: 0 24rpx 24rpx;
}

.calendar-corner,
.calendar-day,
.calendar-hour,
.calendar-cell {
  border-right: 1rpx solid var(--color-border);
  border-bottom: 1rpx solid var(--color-border);
}

.calendar-corner {
  position: sticky;
  left: 0;
  z-index: 4;
  height: 104rpx;
  border-top: 1rpx solid var(--color-border);
  border-left: 1rpx solid var(--color-border);
  background: var(--color-surface-muted);
}

.calendar-day {
  position: sticky;
  top: 0;
  z-index: 3;
  height: 104rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 0 12rpx;
  border-top: 1rpx solid var(--color-border);
  background: var(--color-surface);
}

.calendar-day__label {
  color: var(--color-text);
  font-size: var(--font-size-sm);
  font-weight: 600;
}

.calendar-day__date {
  margin-top: 4rpx;
  color: var(--color-text-secondary);
  font-size: var(--font-size-xs);
}

.calendar-day__weekend {
  align-self: flex-start;
  margin-top: 4rpx;
  padding: 4rpx 8rpx;
  border-radius: 4rpx;
  background: var(--color-warning-soft);
  color: var(--color-warning);
  font-size: 22rpx;
  line-height: 1.2;
}

.calendar-hour {
  position: sticky;
  left: 0;
  z-index: 2;
  height: 96rpx;
  display: flex;
  align-items: flex-start;
  justify-content: center;
  padding-top: 8rpx;
  border-left: 1rpx solid var(--color-border);
  background: var(--color-surface-muted);
  color: var(--color-text-muted);
  font-size: var(--font-size-xs);
}

.calendar-cell {
  position: relative;
  height: 96rpx;
  padding: 8rpx 8rpx;
  background: var(--color-surface);
  color: var(--color-text-secondary);
  overflow: hidden;
}

.calendar-cell__text {
  font-size: var(--font-size-xs);
  font-weight: 700;
  line-height: 1.2;
}

.calendar-cell__sub {
  margin-top: 4rpx;
  font-size: 22rpx;
  line-height: 1.2;
}

.calendar-cell--available {
  background: var(--color-surface);
}

.calendar-cell--booked {
  border-left: 5rpx solid var(--color-primary);
  background: var(--color-primary-soft);
  color: var(--color-primary);
}

.calendar-cell--pending {
  border: 1rpx dashed var(--color-accent);
  background: var(--color-accent-soft);
  color: var(--color-accent);
}

.calendar-cell--maintenance {
  border-left: 5rpx solid var(--color-maintenance);
  background: var(--color-maintenance-soft);
  color: var(--color-maintenance);
}

.calendar-cell--restricted {
  background: var(--color-restricted-soft);
  color: var(--color-restricted);
}

.calendar-cell--past {
  background: var(--color-surface-muted);
  color: var(--color-text-disabled);
}

.calendar-cell--selected {
  border: 2rpx solid var(--color-primary);
  background: var(--color-primary-soft);
  color: var(--color-primary);
}

.calendar-cell--selecting {
  z-index: 1;
  border: 2rpx solid var(--color-primary);
  background: var(--color-primary-soft);
  color: var(--color-primary);
  box-shadow: inset 0 0 0 2rpx var(--color-primary-selection);
}

.calendar-cell--selecting::after {
  content: "";
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: var(--color-primary);
}

.calendar-cell__select-mark {
  position: absolute;
  right: 8rpx;
  bottom: 8rpx;
  padding: 4rpx 8rpx;
  border-radius: var(--radius-sm);
  background: var(--color-primary-selection-soft);
  color: var(--color-primary);
  font-size: 22rpx;
  line-height: 1.2;
}
