<view wx:if="{{visible}}" class="sheet-mask" bindtap="onClose">
  <view class="sheet" catchtap="noop">
    <view class="sheet__handle"></view>
    <view class="sheet__title">{{title}}</view>
    <view class="sheet__time">{{timeText}}</view>
    <view wx:if="{{hint}}" class="sheet__hint sheet__hint--{{hintTone}}">{{hint}}</view>
    <textarea class="textarea sheet__textarea" placeholder="备注，最多 200 字" maxlength="200" value="{{remark}}" bindinput="onRemarkInput"></textarea>
    <view class="sheet__actions">
      <button class="button button--secondary" bindtap="onClose">取消</button>
      <button class="button {{disabled ? 'button--disabled' : primaryClass}}" disabled="{{disabled}}" bindtap="onSubmit">{{submitText}}</button>
    </view>
  </view>
</view>
