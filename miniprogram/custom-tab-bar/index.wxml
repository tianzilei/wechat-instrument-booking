<view class="tab-bar tab-bar--{{theme}}">
  <view
    wx:for="{{list}}"
    wx:key="pagePath"
    class="tab-bar__item {{selected === index ? 'tab-bar__item--active' : ''}}"
    data-index="{{index}}"
    data-path="{{item.pagePath}}"
    bindtap="switchTab"
  >
    <text
      class="tab-bar__text {{selected === index ? 'tab-bar__text--active' : ''}}"
      style="color: {{selected === index ? item.activeColor : '#566762'}};"
    >{{item.text}}</text>
  </view>
</view>
